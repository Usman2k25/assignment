<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets "dotnet user-secrets" and Visual Studio's "Manage User Secrets" store the DB password and JWT key
         outside the project folder (so they never get committed). The id is not a secret. -->
    <UserSecretsId>campus-services-api-5c0e7d3a-8f41-4b6e-9a2d-3e1f6b7c4d90</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampusServices.Application\CampusServices.Application.csproj" />
    <ProjectReference Include="..\CampusServices.Infrastructure\CampusServices.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!-- Needed by "dotnet ef" (migrations). Not part of the running app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
